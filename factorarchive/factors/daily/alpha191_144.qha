version = 1
name = "alpha191_144"
frequency = "1d"
formula = "sum((close < delay(close, 1)) ? (abs((close / delay(close, 1)) - 1) / amount) : 0, 20) / sum((close < delay(close, 1)) ? 1 : 0, 20)"
inputs = ["amount", "close"]
min_window = 21
direction = "unspecified"
category = "price_volume"
adjust = "none"
implementation = "microfactor.factors.alpha191_document::alpha191_144"
implementation_status = "exact"
