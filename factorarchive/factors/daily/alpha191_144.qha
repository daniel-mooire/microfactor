adaptation = "The formula is evaluated in the source-supported fq=None mode so OHLC and VWAP remain in the same unadjusted price units. The signal uses information through the T-day close and is evaluated against the standard T+1 open return. Normalization audit: Expanded SUMIF and COUNT into equivalent conditional rolling sums; the twenty-day condition and denominator are unchanged."
tags = ["document", "alpha191", "daily"]
parameters_json = "{\"alpha191_number\":144,\"normalization\":\"Expanded SUMIF and COUNT into equivalent conditional rolling sums; the twenty-day condition and denominator are unchanged.\",\"normalized_expression\":\"sum((close < delay(close, 1)) ? (abs((close / delay(close, 1)) - 1) / amount) : 0, 20) / sum((close < delay(close, 1)) ? 1 : 0, 20)\",\"recursive_stability_window\":null,\"source_expression\":\"SUMIF(ABS(CLOSE/DELAY(CLOSE,1)-1)/AMOUNT,20,CLOSE<DELAY(CLOSE,1))/COUNT(CLOSE<DELAY(CLOSE,1),20)\",\"source_fq\":null}"
