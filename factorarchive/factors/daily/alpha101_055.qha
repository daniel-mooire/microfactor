version = 1
name = "alpha101_055"
frequency = "1d"
formula = "-1 * correlation(rank((close - ts_min(low, 12)) / (ts_max(high, 12) - ts_min(low, 12))), rank(volume), 6)"
inputs = ["high", "low", "close", "volume"]
min_window = 18
direction = "unspecified"
category = "technical"
adjust = "none"
