frequency = "1d"
formula = "MEAN(SAMPLE(adjusted_close,20,2000)[-18:]+adjusted_close[t-19]+adjusted_close[t])-MEAN(SAMPLE(adjusted_close,20,2000)+adjusted_close[t-19]+adjusted_close[t])"
inputs = ["adjusted_close"]
min_window = 2000
direction = "negative"
category = "mean_reversion"
adjust = "hfq"
