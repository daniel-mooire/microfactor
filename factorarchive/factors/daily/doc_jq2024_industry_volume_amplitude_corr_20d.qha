version = 1
name = "doc_jq2024_industry_volume_amplitude_corr_20d"
frequency = "1d"
formula = "CORR(CS_RANK(volume/Ref(volume,1)-1),CS_RANK(high/low-1),20)"
inputs = ["high", "low", "volume"]
min_window = 20
direction = "unspecified"
category = "price_volume"
adjust = "qfq"
implementation = "microfactor.factors.document_extended:_compute/doc_jq2024_industry_volume_amplitude_corr_20d"
implementation_status = "approximate"
status = "candidate"
source_type = "document"
source_group = "51.-复现-行业有效量价因子与行业轮动策略-5db03cbb"
reference = "5db03cbbdddd5cf6077e6cac313ad8d6c8768a5a5d4a8ebff772fd4bde1bd7d6"
adaptation = "The source applies these formulas to industry ETFs and lists 5/10/20/60/120/180-day windows, but the external VolumePriceFactor192 generator is absent. The implementation publishes only the explicitly listed 20-day formula as an individual-stock daily signal, uses qfq OHLC to avoid corporate-action jumps, and evaluates future one-day open returns instead of the source model's t+2 close versus t+1 open label."
tags = ["document", "daily", "price_volume", "correlation", "industry_etf_adapted"]
parameters_json = "{\"correlation\":\"pearson\",\"rank\":\"daily_cross_sectional_average_percentile\",\"source_asset_type\":\"industry_etf\",\"source_windows\":[5,10,20,60,120,180],\"window_days\":20}"
