version = 1
name = "alpha101_045"
frequency = "1d"
formula = "-1 * rank(sum(delay(close, 5), 20) / 20) * correlation(close, volume, 2) * rank(correlation(sum(close, 5), sum(close, 20), 2))"
inputs = ["close", "volume"]
min_window = 25
direction = "unspecified"
category = "technical"
adjust = "none"
