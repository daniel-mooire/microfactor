parameters_json = "{\"alpha191_number\":156,\"normalization\":\"Only case and redundant parentheses were normalized.\",\"normalized_expression\":\"-1 * max(rank(decaylinear(delta(vwap, 5), 3)), rank(decaylinear(-1 * delta((open * 0.15) + (low * 0.85), 2) / ((open * 0.15) + (low * 0.85)), 3)))\",\"recursive_stability_window\":null,\"source_expression\":\"(MAX(RANK(DECAYLINEAR(DELTA(VWAP,5),3)),RANK(DECAYLINEAR(((DELTA(((OPEN*0.15)+(LOW*0.85)),2)/((OPEN*0.15)+(LOW*0.85)))*-1),3)))*-1)\",\"source_fq\":null}"
