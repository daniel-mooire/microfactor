version = 1
name = "alpha101_060"
frequency = "1d"
formula = "0 - ((2 * scale(rank((((close - low) - (high - close)) / (high - low)) * volume))) - scale(rank(ts_argmax(close, 10))))"
inputs = ["high", "low", "close", "volume"]
min_window = 10
direction = "unspecified"
category = "technical"
adjust = "none"
implementation = "microfactor.factors.alpha101_document::alpha101_060"
implementation_status = "exact"
status = "candidate"
source_type = "document"
source_group = "Alpha101-华泰海量技术因子与原始论文-2fe2a190"
reference = "2fe2a1906be2da0ebc22e655e652cbb495027a0b859b18a0284b9014cb04dc8e"
adaptation = "Formula copied from the Alpha101 report; raw daily OHLC/VWAP is used and the signal is evaluated after the T-day close."
tags = ["document", "alpha101", "daily"]
parameters_json = "{\"delay_sessions\":1,\"factor_number\":60}"
