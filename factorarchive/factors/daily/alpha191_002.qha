parameters_json = "{\"alpha191_number\":2,\"normalization\":\"Balanced the source's unmatched parentheses; operator order and the one-day delta are unchanged.\",\"normalized_expression\":\"-1 * delta(((close - low) - (high - close)) / (high - low), 1)\",\"recursive_stability_window\":null,\"source_expression\":\"-1 * delta((((close-low)-(high-close))/((high-low)),1))\",\"source_fq\":null}"
