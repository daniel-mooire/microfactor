version = 1
name = "alpha101_036"
frequency = "1d"
formula = "(2.21 * rank(correlation(close - open, delay(volume, 1), 15))) + (0.7 * rank(open - close)) + (0.73 * rank(Ts_Rank(delay(-1 * returns, 6), 5))) + rank(abs(correlation(vwap, adv20, 6))) + (0.6 * rank(((sum(close, 200) / 200) - open) * (close - open)))"
inputs = ["open", "close", "volume", "amount", "close_to_close_total_return_1d"]
min_window = 200
direction = "unspecified"
category = "technical"
adjust = "none"
implementation = "microfactor.factors.alpha101_document::alpha101_036"
implementation_status = "exact"
status = "candidate"
source_type = "document"
source_group = "Alpha101-华泰海量技术因子与原始论文-2fe2a190"
reference = "2fe2a1906be2da0ebc22e655e652cbb495027a0b859b18a0284b9014cb04dc8e"
adaptation = "Formula copied from the Alpha101 report; raw daily OHLC/VWAP is used and the signal is evaluated after the T-day close. Returns use Microfactor's supplied total-return field under the same panel contract."
tags = ["document", "alpha101", "daily"]
parameters_json = "{\"delay_sessions\":1,\"factor_number\":36}"
