version = 1
name = "doc_jq2022_price_position_250d"
frequency = "1d"
formula = "(close-MIN(low,250))/(MAX(high,250)-MIN(low,250))"
inputs = ["high", "low", "close", "is_suspended"]
min_window = 250
direction = "positive"
category = "momentum"
adjust = "qfq"
implementation = "microfactor.factors.document_extended:_compute/doc_jq2022_price_position_250d"
implementation_status = "approximate"
status = "candidate"
source_type = "document"
source_group = "97.-涨停研究一-具有哪些因子的股票更容易涨停-9cd87e21"
reference = "9cd87e21efc53f85c9178c54bfeb78df28c32125c6c565744df21f76215698c8"
adaptation = "源码把该连续量与截面均值比较后作为次日涨停事件筛选条件，并叠加流通市值与历史涨停次数过滤；实现仅暴露完全披露的250日原始价格位置，统一评估未来open_t1收益，不把离散策略条件包装成因子。"
tags = ["document", "daily", "price_position", "limit_up_study"]
parameters_json = "{\"fill_paused\":true,\"source_target\":\"next_day_limit_up\",\"source_threshold\":\"cross_sectional_mean\",\"window\":250}"
