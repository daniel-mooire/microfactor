formula = "SUM(RMS((MA13,MA21,MA55)/MEDIAN-1),lags=1..20)-SUM(IF(MA13>=MA21>=MA55,(MA13-MA21)/MA21+(MA21-MA55)/MA55,0),lags=0..4)"
