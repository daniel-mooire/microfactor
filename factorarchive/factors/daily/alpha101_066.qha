version = 1
name = "alpha101_066"
frequency = "1d"
formula = "(rank(decay_linear(delta(vwap, 3.51013), 7.23052)) + Ts_Rank(decay_linear((((low * 0.96633) + (low * (1 - 0.96633))) - vwap) / (open - ((high + low) / 2)), 11.4157), 6.72611)) * -1"
inputs = ["open", "high", "low", "volume", "amount"]
min_window = 17
direction = "unspecified"
category = "technical"
adjust = "none"
