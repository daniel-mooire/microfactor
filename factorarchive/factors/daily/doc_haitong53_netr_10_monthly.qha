version = 1
name = "doc_haitong53_netr_10_monthly"
frequency = "1d"
formula = "mean available-session 20d compounded return of the top 10% peers ranked by absolute 20d daily-return correlation with at least 15 pairwise observations"
inputs = ["close_total_return_index", "is_suspended", "is_st", "list_date"]
min_window = 21
direction = "negative"
category = "network_reversal"
