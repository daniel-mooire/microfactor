version = 1
name = "alpha191_180"
frequency = "1d"
formula = "(mean(volume, 20) < volume) ? ((-1 * tsrank(abs(delta(close, 7)), 60)) * sign(delta(close, 7))) : (-1 * volume)"
inputs = ["close", "volume"]
