parameters_json = "{\"alpha191_number\":180,\"normalization\":\"Only case and redundant parentheses were normalized.\",\"normalized_expression\":\"(mean(volume, 20) < volume) ? ((-1 * tsrank(abs(delta(close, 7)), 60)) * sign(delta(close, 7))) : (-1 * volume)\",\"recursive_stability_window\":null,\"source_expression\":\"((MEAN(VOLUME,20)<VOLUME)?((-1*TSRANK(ABS(DELTA(CLOSE,7)),60))*SIGN(DELTA(CLOSE,7)):(-1*VOLUME)))\",\"source_fq\":null}"
