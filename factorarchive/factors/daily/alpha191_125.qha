parameters_json = "{\"alpha191_number\":125,\"normalization\":\"Only case and redundant parentheses were normalized.\",\"normalized_expression\":\"rank(decaylinear(corr(vwap, mean(volume, 80), 17), 20)) / rank(decaylinear(delta((close * 0.5) + (vwap * 0.5), 3), 16))\",\"recursive_stability_window\":null,\"source_expression\":\"(RANK(DECAYLINEAR(CORR((VWAP),MEAN(VOLUME,80),17),20))/RANK(DECAYLINEAR(DELTA(((CLOSE*0.5)+(VWAP*0.5)),3),16)))\",\"source_fq\":null}"
