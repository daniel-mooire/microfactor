version = 1
name = "doc_jq2023_price_trend_slope_5d"
frequency = "1d"
formula = "round(OLS_slope(adjusted_close[t-4:t] ~ 1 + day), 3)"
inputs = ["adjusted_close"]
min_window = 5
direction = "positive"
category = "momentum"
adjust = "qfq"
implementation = "microfactor.factors.document_extended:_compute/doc_jq2023_price_trend_slope_5d"
implementation_status = "approximate"
status = "candidate"
source_type = "document"
source_group = "57.韶华研究之四-菲阿里四阶在T-1的短线策略应用-b3cbb8cb"
reference = "b3cbb8cb957298328a09e4fa9f632d907d27956644634640bec5015a253eb974"
adaptation = "The source first applies tradability, listing-age, price, market-cap, PE, PB, and positive 60-day raw-slope filters, then keeps stocks whose rounded 5-day raw close-price slope exceeds 2. The implementation exposes only the explicit rounded 5-day continuous score across the current daily universe; it does not reproduce the upstream filters or the T+1 limit-order strategy."
tags = ["document", "daily", "momentum", "trend", "ols", "slope"]
parameters_json = "{\"dependent_variable\":\"adjusted_close\",\"include_intercept\":true,\"round_decimals\":3,\"source_keep_threshold\":2.0,\"source_prefilter_min_slope\":0.0,\"source_prefilter_window_days\":60,\"source_sort\":\"descending_raw_slope\",\"window_days\":5}"
