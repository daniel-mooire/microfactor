version = 1
name = "doc_jq2023_price_trend_r2_120d"
frequency = "1d"
formula = "OLS_R2(adjusted_close[t-119:t] ~ 1 + day)"
inputs = ["adjusted_close"]
min_window = 120
direction = "positive"
category = "trend"
adjust = "qfq"
