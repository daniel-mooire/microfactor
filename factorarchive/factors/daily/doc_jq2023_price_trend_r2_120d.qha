adaptation = "The source ranks the 120-day close-price regression R-squared descending after CSI 300 membership, tradability, price, recent-high, volume-ratio, normalized-slope, and R-squared filters. The implementation exposes only that explicit continuous ranking score across the current daily stock universe. JoinQuant's dynamic real-price adjustment is not pinned, so the project uses qfq adjusted close."
tags = ["document", "daily", "trend", "ols", "r_squared"]
parameters_json = "{\"dependent_variable\":\"adjusted_close\",\"include_intercept\":true,\"source_index\":\"000300.XSHG\",\"source_normalized_slope_threshold\":0.005,\"source_r_squared_threshold\":0.8,\"source_sort\":\"descending_r_squared\",\"window_days\":120}"
