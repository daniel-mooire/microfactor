version = 1
name = "alpha101_051"
frequency = "1d"
formula = "((((delay(close, 20) - delay(close, 10)) / 10) - ((delay(close, 10) - close) / 10)) < -0.05) ? 1 : (-1 * (close - delay(close, 1)))"
inputs = ["close"]
min_window = 20
direction = "unspecified"
category = "technical"
adjust = "none"
