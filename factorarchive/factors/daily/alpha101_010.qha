version = 1
name = "alpha101_010"
frequency = "1d"
formula = "rank((0 < ts_min(delta(close, 1), 4)) ? delta(close, 1) : ((ts_max(delta(close, 1), 4) < 0) ? delta(close, 1) : (-1 * delta(close, 1))))"
inputs = ["close"]
min_window = 5
direction = "unspecified"
category = "technical"
adjust = "none"
