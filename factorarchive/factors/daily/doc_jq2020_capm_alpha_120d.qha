version = 1
name = "doc_jq2020_capm_alpha_120d"
frequency = "1d"
formula = "intercept from 120d OLS((stock_return-rf) ~ 1 + (market_return-rf))"
inputs = ["close_to_close_total_return_1d"]
min_window = 120
direction = "positive"
category = "momentum"
adjust = "none"
implementation = "microfactor.factors.document_extended:_compute/doc_jq2020_capm_alpha_120d"
implementation_status = "approximate"
status = "candidate"
source_type = "document"
source_group = "71-投资学-CAPM单因子回归模型-ROE股票池-含止损-6a812af5"
reference = "6a812af5a6d5ef36b7893d4de3b3d61023a9bec85f257cfd3f815f67ca9127e5"
adaptation = "The source uses 121 close prices for CSI 300 and each ROE-screened stock, subtracts 0.04/252 from each of the resulting 120 daily returns, and ranks the regression intercept descending. The current contract does not expose a CSI 300 return panel or point-in-time ROE, so the implementation exposes only the continuous intercept, uses close-to-close total returns, and uses the daily equal-weight return of the available stock universe as the market proxy."
tags = ["document", "daily", "capm", "alpha", "regression"]
